{
  "openapi": "3.0.3",
  "info": {
    "title": "飞牛影视（fnOS TrimMedia）服务端 API",
    "version": "1.0.0",
    "description": "FnTube「飞牛 client」实际调用的上游飞牛影视（fnOS TrimMedia）服务端接口集合。\n\n## 服务地址\n默认 baseUrl 形如 `http://IP:端口/v`（含 `/v` 后缀）。用户配置的「服务端地址」若未以 `/v` 结尾，客户端会自动补 `/v` 后重试。\n\n## 鉴权\n所有 `/api/*` 接口需要携带以下请求头：\n- `Authorization`: 登录接口返回的 `data.token`（登录前不携带）。\n- `authx`: 请求签名，格式 `nonce={6位随机数}&timestamp={毫秒时间戳}&sign={md5签名}`。\n\n签名算法（Go 实现见 `client.getAuthx`）：\n```\napiPathStr = \"/v\" + apiPath（例如 /v/api/v1/item/list）\ndataHash   = md5(body)          // GET 且无 body 时为 query string 的编码值\nsign       = md5(secret + \"_\" + apiPathStr + \"_\" + nonce + \"_\" + ts + \"_\" + dataHash + \"_\" + apiKey)\n```\n其中 `apiKey`、`secret` 为客户端内置常量（`16CCEB3D-AB42-077D-36A1-F355324E4237` / `NDzZTVxnRKP8Z0jXg1VAMonaG8akvh`）。\n\n## 统一响应结构\n所有 `/api/*` 接口返回统一包裹：`{ \"code\": int, \"msg\": string, \"data\": ... }`，`code == 0` 表示成功。\n"
  },
  "servers": [
    {
      "url": "{{baseUrl}}",
      "description": "飞牛影视服务端地址（含 /v），例如 http://127.0.0.1:5666/v"
    },
    {
      "url": "{{hostRoot}}",
      "description": "主机根地址（不含 /v），仅访问码校验接口使用，例如 http://127.0.0.1:5666"
    }
  ],
  "security": [
    {
      "Authorization": [],
      "authx": []
    }
  ],
  "tags": [
    { "name": "认证", "description": "访问码校验、登录与退出" },
    { "name": "用户", "description": "用户信息与用户管理" },
    { "name": "系统", "description": "版本号与图片资源" },
    { "name": "媒体库", "description": "媒体库列表、扫描与统计" },
    { "name": "媒体项", "description": "媒体条目列表、详情与删除" },
    { "name": "搜索", "description": "搜索影片与演员" },
    { "name": "剧集", "description": "季与剧集列表" },
    { "name": "演职员", "description": "媒体演职员列表" },
    { "name": "播放", "description": "继续观看列表" },
    { "name": "任务", "description": "后台任务状态" }
  ],
  "paths": {
    "/c/{code}": {
      "get": {
        "tags": ["认证"],
        "summary": "访问码校验",
        "operationId": "verifyAccessCode",
        "description": "校验访问码。注意：此接口基于主机根地址（不含 /v 后缀），使用服务器 `{{hostRoot}}`；返回非 JSON（HTML/跳转），HTTP 200 表示校验通过，404 表示访问码错误。客户端仅在开启了「访问码」时才调用。",
        "servers": [{ "url": "{{hostRoot}}" }],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "description": "访问码",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "访问码校验通过" },
          "404": { "description": "访问码错误" }
        }
      }
    },
    "/api/v2/user/loginByPassword": {
      "post": {
        "tags": ["认证"],
        "summary": "登录（v2，SHA256 密码）",
        "operationId": "loginByPasswordV2",
        "description": "优先使用的 v2 登录协议，密码传输 SHA256 摘要。返回 data.token。v2 接口不存在时客户端回退到 v1 明文登录。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginV2Request" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录结果",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 0 },
                    "msg": { "type": "string", "example": "" },
                    "data": { "$ref": "#/components/schemas/TokenData" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/login": {
      "post": {
        "tags": ["认证"],
        "summary": "登录（v1 回退，明文密码）",
        "operationId": "loginV1",
        "description": "旧版服务端的明文登录协议，仅当 v2 接口不可用时回退调用。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginV1Request" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录结果",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 0 },
                    "msg": { "type": "string", "example": "" },
                    "data": { "$ref": "#/components/schemas/TokenData" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/user/logout": {
      "post": {
        "tags": ["认证"],
        "summary": "退出登录",
        "operationId": "logout",
        "description": "退出当前登录账号，使 Authorization token 失效。",
        "responses": {
          "200": {
            "description": "退出结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmptyEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/v1/user/info": {
      "get": {
        "tags": ["用户"],
        "summary": "当前用户信息",
        "operationId": "userInfo",
        "description": "获取当前登录用户信息，含 guid、username、is_admin。",
        "responses": {
          "200": {
            "description": "用户信息",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 0 },
                    "msg": { "type": "string", "example": "" },
                    "data": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/manager/user/list": {
      "get": {
        "tags": ["用户"],
        "summary": "用户列表（管理员）",
        "operationId": "userList",
        "description": "获取全部用户列表，仅管理员账号有权访问。data 为 User 数组。",
        "responses": {
          "200": {
            "description": "用户列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 0 },
                    "msg": { "type": "string", "example": "" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/User" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sys/version": {
      "get": {
        "tags": ["系统"],
        "summary": "获取飞牛影视版本号",
        "operationId": "sysVersion",
        "description": "获取前端与后端（mediasrv）版本号，也用于探测服务是否可连接。data.version 为前端版本，data.mediasrvVersion 为后端版本。",
        "responses": {
          "200": {
            "description": "版本信息",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
