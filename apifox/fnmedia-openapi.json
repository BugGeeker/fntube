  "components": {
    "securitySchemes": {
      "Authorization": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "登录接口返回的 data.token（登录/访问码校验接口可不携带）"
      },
      "authx": {
        "type": "apiKey",
        "in": "header",
        "name": "authx",
        "description": "请求签名，格式 nonce=xxx&timestamp=xxx&sign=xxx，算法见 info.description"
      }
    },
    "schemas": {
      "EmptyBody": {
        "type": "object",
        "description": "空请求体（客户端固定发送 {} ）",
        "additionalProperties": true
      },
      "EmptyEnvelope": {
        "type": "object",
        "description": "统一响应包裹（无具名 data 场景）",
        "properties": {
          "code": { "type": "integer", "description": "0 表示成功", "example": 0 },
          "msg": { "type": "string", "example": "" },
          "data": { "description": "业务数据，随接口而定" }
        }
      },
      "TokenData": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "description": "登录令牌，后续接口放入 Authorization 头" }
        }
      },
      "LoginV2Request": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "description": "用户名" },
          "password": { "type": "string", "description": "密码的 SHA256 十六进制摘要" },
          "app_name": { "type": "string", "description": "应用标识，客户端固定 \"trimemedia-web\"", "example": "trimemedia-web" }
        }
      },
      "LoginV1Request": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "description": "用户名" },
          "password": { "type": "string", "description": "明文密码（仅旧版服务端回退使用）" },
          "app_name": { "type": "string", "description": "应用标识，客户端固定 \"trimemedia-web\"", "example": "trimemedia-web" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "guid": { "type": "string" },
          "username": { "type": "string" },
          "is_admin": { "type": "integer", "description": "1 表示管理员" }
        }
      },
      "VersionData": {
        "type": "object",
        "properties": {
          "version": { "type": "string", "description": "前端版本" },
          "mediasrvVersion": { "type": "string", "description": "后端（mediasrv）版本" }
        }
      },
      "MediaDb": {
        "type": "object",
        "properties": {
          "guid": { "type": "string", "description": "媒体库 GUID" },
          "category": { "type": "string", "description": "分类：Movie / TV / Mix / Others 等" },
          "name": { "type": "string", "description": "媒体库名称（管理员接口为 name，普通用户接口为 title）" },
          "posters": { "type": "array", "items": { "type": "string" }, "description": "海报路径" },
          "dir_list": { "type": "array", "items": { "type": "string" }, "description": "物理目录列表" }
        }
      },
      "MediaDbListData": {
        "type": "object",
        "properties": {
          "list": { "type": "array", "items": { "$ref": "#/components/schemas/MediaDb" } }
        }
      },
      "MediaDbSummary": {
        "type": "object",
        "properties": {
          "movie": { "type": "integer" },
          "tv": { "type": "integer" },
          "video": { "type": "integer" },
          "favorite": { "type": "integer" },
          "total": { "type": "integer" }
        }
      },
      "ItemListRequest": {
        "type": "object",
        "required": ["tags", "page", "page_size"],
        "properties": {
          "tags": {
            "type": "object",
            "description": "类型过滤",
            "properties": {
              "type": {
                "type": "array",
                "items": { "type": "string" },
                "description": "类型列表：Movie / TV / Season / Episode / Video / Directory"
              }
            }
          },
          "sort_type": { "type": "string", "description": "排序方向 ASC / DESC", "example": "DESC" },
          "sort_column": { "type": "string", "description": "排序字段", "example": "create_time" },
          "page": { "type": "integer", "description": "页码（从 1 开始）", "example": 1 },
          "page_size": { "type": "integer", "description": "每页数量", "example": 20 },
          "ancestor_guid": { "type": "string", "description": "上级媒体库 GUID，为空则全部" },
          "exclude_grouped_video": { "type": "integer", "description": "1 表示排除分组的视频", "example": 1 }
        }
      },
      "ItemListData": {
        "type": "object",
        "properties": {
          "list": { "type": "array", "items": { "$ref": "#/components/schemas/Item" } },
          "total": { "type": "integer" }
        }
      },
      "DeleteItemRequest": {
        "type": "object",
        "properties": {
          "delete_file": { "type": "integer", "description": "1 删除媒体文件，0 仅从媒体库移除", "example": 0 },
          "media_guids": { "type": "array", "items": { "type": "string" }, "description": "关联媒体 GUID 列表" }
        }
      },
      "PersonListData": {
        "type": "object",
        "properties": {
          "total": { "type": "integer" },
          "list": { "type": "array", "items": { "$ref": "#/components/schemas/Person" } }
        }
      },
      "MediaStream": {
        "type": "object",
        "properties": {
          "resolutions": { "type": "array", "items": { "type": "string" } },
          "audio_type": { "type": "array", "items": { "type": "string" } },
          "color_range_type": { "type": "array", "items": { "type": "string" } }
        }
      },
      "Item": {
        "type": "object",
        "description": "媒体条目（对齐 /item 接口响应字段）",
        "properties": {
          "guid": { "type": "string" },
          "ancestor_guid": { "type": "string" },
          "type": { "type": "string", "description": "Movie / TV / Season / Episode / Video / Directory" },
          "tv_title": { "type": "string" },
          "parent_title": { "type": "string" },
          "title": { "type": "string" },
          "original_title": { "type": "string" },
          "overview": { "type": "string" },
          "poster": { "type": "string" },
          "backdrops": { "type": "string" },
          "posters": { "type": "string" },
          "logos": { "type": "string" },
          "douban_id": { "type": "integer" },
          "imdb_id": { "type": "string" },
          "trim_id": { "type": "string", "description": "飞牛 TMDB ID（tt* 表示电影，tm* 表示剧集）" },
          "release_date": { "type": "string" },
          "air_date": { "type": "string" },
          "vote_average": { "type": "string" },
          "season_number": { "type": "integer" },
          "episode_number": { "type": "integer" },
          "duration": { "type": "integer", "description": "片长（秒）" },
          "ts": { "type": "integer", "description": "已播放（秒）" },
          "watched": { "type": "integer", "description": "1 表示已看完" },
          "poster_width": { "type": "integer" },
          "poster_height": { "type": "integer" },
          "genres": { "type": "array", "items": { "type": "integer" } },
          "runtime": { "type": "integer", "description": "片长（分钟）" },
          "production_countries": { "type": "array", "items": { "type": "string" } },
          "is_favorite": { "type": "integer" },
          "is_watched": { "type": "integer" },
          "watched_ts": { "type": "integer" },
          "number_of_episodes": { "type": "integer" },
          "local_number_of_episodes": { "type": "integer" },
          "local_number_of_seasons": { "type": "integer" },
          "can_play": { "type": "integer" },
          "play_error": { "type": "string" },
          "parent_guid": { "type": "string" },
          "ancestor_name": { "type": "string" },
          "ancestor_category": { "type": "string" },
          "play_item_guid": { "type": "string" },
          "logic_type": { "type": "integer" },
          "media_stream": { "$ref": "#/components/schemas/MediaStream" }
        }
      },
      "Person": {
        "type": "object",
        "description": "演职员信息",
        "properties": {
          "item_guid": { "type": "string" },
          "person_guid": { "type": "string" },
          "role": { "type": "string" },
          "job": { "type": "string" },
          "order": { "type": "integer" },
          "department": { "type": "string" },
          "trim_id": { "type": "string" },
          "imdb_id": { "type": "string" },
          "tmdb_id": { "type": "integer" },
          "lan": { "type": "string" },
          "name": { "type": "string" },
          "original_name": { "type": "string" },
          "also_know_as": { "type": "string" },
          "biography": { "type": "string" },
          "known_for_department": { "type": "string" },
          "profile_path": { "type": "string" },
          "gender": { "type": "integer" }
        }
      }
    }
  }
}