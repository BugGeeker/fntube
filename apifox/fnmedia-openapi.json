                    "code": { "type": "integer", "example": 0 },
                    "msg": { "type": "string", "example": "" },
                    "data": { "$ref": "#/components/schemas/VersionData" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sys/img/{path}": {
      "get": {
        "tags": ["系统"],
        "summary": "获取图片资源",
        "operationId": "getImg",
        "description": "获取海报/背景/Logo 等图片资源。path 为图片相对路径，可能包含多级斜杠（如 poster/xxx.jpg），由客户端对图片字段拼接 `/sys/img` 得到。",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "description": "图片相对路径（可含 /，如 poster/xxx.jpg）",
            "schema": { "type": "string" }
          },
          {
            "name": "w",
            "in": "query",
            "required": false,
            "description": "缩略图宽度（可选），如 w=256",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "图片二进制内容",
            "content": {
              "image/*": { "schema": { "type": "string", "format": "binary" } }
            }
          }
        }
      }
    },
    "/api/v1/mediadb/list": {
      "get": {
