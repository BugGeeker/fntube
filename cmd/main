#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

# write the command to start your program here 
CMD="${TRIM_APPDEST}/server/fntube"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

start_process() {
    if status; then
        return 0
    fi

    log_msg "Starting process ..."
    rm -f "${TRIM_APPDEST}/app.sock"
    FNTUBE_UNIFIED_GATEWAY=1 bash -c "${CMD}" >> ${LOG_FILE} 2>&1 &
    pid=$!
    printf "%s" "${pid}" > ${PID_FILE}

    SOCKET_PATH="${TRIM_APPDEST}/app.sock"
    HEALTH_URL="http://localhost/app/FnTube/api/health"
    CURL_HAS_UNIX_SOCKET=0
    if command -v curl >/dev/null 2>&1 && curl --help all 2>/dev/null | grep -q -- "--unix-socket"; then
        CURL_HAS_UNIX_SOCKET=1
    fi

    count=0
    while [ $count -lt 15 ]; do
        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            log_msg "Process exited before the gateway socket was ready."
            tail -n 20 "${LOG_FILE}" > "${TRIM_TEMP_LOGFILE}" 2>/dev/null
            return 1
        fi

        if [ -e "${SOCKET_PATH}" ] || [ -S "${SOCKET_PATH}" ]; then
            if [ "${CURL_HAS_UNIX_SOCKET}" -eq 1 ]; then
                if curl -fsS --max-time 2 --unix-socket "${SOCKET_PATH}" "${HEALTH_URL}" >/dev/null 2>&1; then
                    log_msg "Gateway socket health check passed."
                    ls -ld "${TRIM_APPDEST}" "${SOCKET_PATH}" >> "${LOG_FILE}" 2>&1
                    return 0
                fi
            else
                log_msg "Gateway socket is ready; curl does not support Unix Socket health checks."
                ls -ld "${TRIM_APPDEST}" "${SOCKET_PATH}" >> "${LOG_FILE}" 2>&1
                return 0
            fi
        fi

        sleep 1
        count=$((count + 1))
    done

    rm -f "${PID_FILE}"
    log_msg "Gateway socket health check failed."
    ls -ld "${TRIM_APPDEST}" "${SOCKET_PATH}" "/var/apps/FnTube/target" >> "${LOG_FILE}" 2>&1
    tail -n 20 "${LOG_FILE}" > "${TRIM_TEMP_LOGFILE}" 2>/dev/null
    kill -TERM "${pid}" 2>/dev/null
    return 1
}

stop_process() {
    log_msg "Stopping process ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        
        log_msg "pid=${pid}"
        if ! check_process "${pid}"; then
            # process not exist, delete pidfile
            rm -f "${PID_FILE}"
            log_msg "remove pid file 1"
            return
        fi

        log_msg "send TERM signal to PID:${pid}..."
        kill -TERM ${pid} >> ${LOG_FILE} 2>&1

        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done

        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}"
            sleep 1
            rm -f "${PID_FILE}"
        else
            log_msg "process killed... "
        fi
    fi

    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0  # process exist
    else
        return 1  # process not exist
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            # Process is not running but pidfile exists - clean it up
            rm -f "${PID_FILE}"
        fi    
    fi

    return 1
}

case $1 in
start)
    # run start command. exit 0 if success, exit 1 if failed
    start_process
    ;;
stop)
    # run stop command. exit 0 if success, exit 1 if failed
    stop_process
    ;;
status)
    # check application status command. exit 0 if running, exit 3 if not running
    if status; then 
        exit 0
    else 
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
